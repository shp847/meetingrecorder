{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meeting-recorder.local/schemas/diarization-fixture-catalog-v2.schema.json",
  "title": "Meeting Recorder Private Fixture Catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtures"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "fixtures": {
      "type": "array",
      "items": { "$ref": "#/$defs/fixture" }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "contentHash", "category", "mode", "scenarioTags", "consentRecord", "classification", "owner", "expiresAtUtc", "enabled", "expectedOutcomeRef", "inputRoot", "transcriptJsonPath", "protectedArtifactPaths"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "version": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "category": { "type": "string", "enum": ["two-speaker", "one-speaker", "three-plus-speaker", "short-call", "noisy-similar-voices", "overlap", "hybrid-shared-mic", "no-speech"] },
        "mode": { "enum": ["stored-turn", "full-audio"] },
        "scenarioTags": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "consentRecord": { "type": "string", "minLength": 1 },
        "classification": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "expiresAtUtc": { "type": "string", "format": "date-time" },
        "enabled": { "type": "boolean" },
        "disabledReason": { "type": "string" },
        "expectedOutcomeRef": { "type": "string", "minLength": 1 },
        "inputRoot": { "type": "string", "minLength": 1 },
        "manifestPath": { "type": "string" },
        "audioPath": { "type": "string" },
        "transcriptionSnapshotPath": { "type": "string" },
        "transcriptJsonPath": { "type": "string" },
        "transcriptMarkdownPath": { "type": "string" },
        "configPath": { "type": "string" },
        "enableSpeakerNameMatching": { "type": "boolean" },
        "protectedArtifactPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
