<Window x:Class="MeetingRecorder.App.MeetingDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meeting Details"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppCanvasBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AppPlatform.Shell.Wpf;component/ShellTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="12"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="Meetings / Detail" />
                <TextBlock x:Name="MeetingTitleTextBlock"
                           Margin="0,8,0,0"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="MeetingSubtitleTextBlock"
                           Margin="0,6,0,0"
                           FontFamily="{StaticResource AppMonoFontFamily}"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           TextWrapping="Wrap" />
                <Border x:Name="DetailTaskCenterBorder"
                        Margin="0,12,0,0"
                        Padding="10"
                        Background="{StaticResource AppMutedCardBrush}"
                        BorderBrush="{StaticResource AppOutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock x:Name="DetailTaskCenterHeadlineTextBlock"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailTaskCenterReasonTextBlock"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource AppMutedTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailTaskCenterFreshnessTextBlock"
                                   Margin="0,4,0,0"
                                   FontFamily="{StaticResource AppMonoFontFamily}"
                                   Foreground="{StaticResource AppMutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <WrapPanel Grid.Column="1"
                       Margin="16,0,0,0"
                       VerticalAlignment="Top">
                <Button x:Name="OpenTranscriptButton"
                        Margin="0,0,10,10"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Click="OpenTranscriptButton_OnClick"
                        Content="Open Transcript" />
                <Button x:Name="OpenAudioButton"
                        Margin="0,0,10,10"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Click="OpenAudioButton_OnClick"
                        Content="Open Audio" />
                <Button x:Name="OpenFolderButton"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Click="OpenFolderButton_OnClick"
                        Content="Open Folder" />
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource DialogCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DialogSectionTitleStyle}"
                                       Text="AI Summary" />
                            <TextBlock x:Name="AiSummaryStatusTextBlock"
                                       Margin="0,10,0,0"
                                       AutomationProperties.LiveSetting="Polite"
                                       Style="{StaticResource DialogBodyTextStyle}" />
                            <StackPanel x:Name="AiSummaryGeneratedContentPanel"
                                        Margin="0,12,0,0">
                                <TextBlock FontWeight="SemiBold"
                                           Text="Overview" />
                                <TextBlock x:Name="AiSummaryOverviewTextBlock"
                                           Margin="0,4,0,12"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource DialogBodyTextStyle}" />

                                <TextBlock x:Name="AiSummaryKeyPointsHeaderTextBlock"
                                           FontWeight="SemiBold"
                                           Text="Key Points" />
                                <ItemsControl x:Name="AiSummaryKeyPointsItemsControl"
                                              Margin="0,4,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,0,0,4"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource DialogBodyTextStyle}"
                                                       Text="{Binding StringFormat=- {0}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="AiSummaryDecisionsHeaderTextBlock"
                                           FontWeight="SemiBold"
                                           Text="Decisions" />
                                <ItemsControl x:Name="AiSummaryDecisionsItemsControl"
                                              Margin="0,4,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,0,0,4"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource DialogBodyTextStyle}"
                                                       Text="{Binding StringFormat=- {0}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="AiSummaryActionItemsHeaderTextBlock"
                                           FontWeight="SemiBold"
                                           Text="Action Items" />
                                <ItemsControl x:Name="AiSummaryActionItemsControl"
                                              Margin="0,4,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock TextWrapping="Wrap"
                                                           Style="{StaticResource DialogBodyTextStyle}"
                                                           Text="{Binding Text, StringFormat=- {0}}" />
                                                <TextBlock Margin="12,2,0,0"
                                                           Foreground="{StaticResource AppMutedTextBrush}"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="Owner: {0} | Due: {1}">
                                                            <Binding Path="Owner" TargetNullValue="Unassigned" />
                                                            <Binding Path="DueDateText" TargetNullValue="None" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="AiSummaryRisksHeaderTextBlock"
                                           FontWeight="SemiBold"
                                           Text="Risks / Open Questions" />
                                <ItemsControl x:Name="AiSummaryRisksItemsControl"
                                              Margin="0,4,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,0,0,4"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource DialogBodyTextStyle}"
                                                       Text="{Binding StringFormat=- {0}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="AiSummaryProviderTextBlock"
                                           Foreground="{StaticResource AppMutedTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="AiSummaryGeneratedAtTextBlock"
                                           Margin="0,3,0,0"
                                           Foreground="{StaticResource AppMutedTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="AiSummaryWarningTextBlock"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource AppAccentBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="ConfigureSummariesButton"
                                        Width="150"
                                        Height="30"
                                        Margin="0,0,8,8"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Click="ConfigureSummariesButton_OnClick"
                                        Content="Configure Summaries" />
                                <Button x:Name="GenerateSummaryButton"
                                        Width="132"
                                        Height="30"
                                        Margin="0,0,8,8"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Click="GenerateSummaryButton_OnClick"
                                        Content="Generate Summary" />
                                <Button x:Name="RetrySummaryButton"
                                        Width="112"
                                        Height="30"
                                        Margin="0,0,8,8"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Click="RetrySummaryButton_OnClick"
                                        Content="Retry Summary" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Style="{StaticResource DialogCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DialogSectionTitleStyle}"
                                       Text="Meeting" />
                            <UniformGrid Margin="0,10,0,0"
                                         Columns="2">
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock FontWeight="SemiBold" Text="Project" />
                                    <TextBlock x:Name="ProjectTextBlock"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource DialogBodyTextStyle}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock FontWeight="SemiBold" Text="Status" />
                                    <TextBlock x:Name="StatusTextBlock"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource DialogBodyTextStyle}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock FontWeight="SemiBold" Text="Model" />
                                    <TextBlock x:Name="TranscriptModelTextBlock"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource DialogBodyTextStyle}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock FontWeight="SemiBold" Text="Speakers" />
                                    <TextBlock x:Name="SpeakerStateTextBlock"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource DialogBodyTextStyle}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Expander Margin="0,14,0,0"
                              Header="Recommendations">
                        <Border Style="{StaticResource DialogCardStyle}">
                            <StackPanel>
                                <ItemsControl x:Name="RecommendationItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,8,8"
                                                    Padding="8,4"
                                                    CornerRadius="4"
                                                    Background="{StaticResource AppMutedCardBrush}"
                                                    BorderBrush="{StaticResource AppOutlineBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoRecommendationsTextBlock"
                                           Style="{StaticResource DialogBodyTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander Margin="0,14,0,0"
                              Header="Attendees">
                        <Border Style="{StaticResource DialogCardStyle}">
                            <StackPanel>
                                <ItemsControl x:Name="AttendeeItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,0,0,6"
                                                       Style="{StaticResource DialogBodyTextStyle}"
                                                       Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoAttendeesTextBlock"
                                           Style="{StaticResource DialogBodyTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander Margin="0,14,0,0"
                              Header="Diagnostics">
                        <Border Style="{StaticResource DialogCardStyle}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Detected Audio Source" />
                                <TextBlock x:Name="DetectedAudioSourceTextBlock"
                                           Margin="0,6,0,0"
                                           Style="{StaticResource DialogBodyTextStyle}" />
                                <TextBlock Margin="0,12,0,0"
                                           FontWeight="SemiBold"
                                           Text="Capture Diagnostics" />
                                <TextBlock x:Name="CaptureDiagnosticsTextBlock"
                                           Margin="0,6,0,0"
                                           FontFamily="{StaticResource AppMonoFontFamily}"
                                           Style="{StaticResource DialogBodyTextStyle}"
                                           xml:space="preserve" />
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander x:Name="MaintenanceExpander"
                              Margin="0,14,0,0"
                              Header="Organize &amp; Fix">
                        <Border Style="{StaticResource DialogCardStyle}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Organize" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource DialogBodyTextStyle}"
                                           Text="Edit the meeting title or project without changing transcript content." />
                                <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Title" />
                                <TextBox x:Name="TitleDraftTextBox"
                                         Margin="0,6,0,0"
                                         Height="32"
                                         VerticalContentAlignment="Center" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="RenameButton"
                                            Margin="0,0,10,10"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Click="RenameButton_OnClick"
                                            Content="Rename" />
                                    <Button x:Name="SuggestTitleButton"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Click="SuggestTitleButton_OnClick"
                                            Content="Suggest Title" />
                                </WrapPanel>

                                <TextBlock Margin="0,10,0,0"
                                           FontWeight="SemiBold"
                                           Text="Project" />
                                <ComboBox x:Name="ProjectComboBox"
                                          Margin="0,6,0,0"
                                          Height="32"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="ApplyProjectButton"
                                            Margin="0,0,10,10"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Click="ApplyProjectButton_OnClick"
                                            Content="Apply Project" />
                                    <Button x:Name="ClearProjectButton"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Click="ClearProjectButton_OnClick"
                                            Content="Clear Project" />
                                </WrapPanel>

                                <TextBlock Margin="0,16,0,0"
                                           FontWeight="SemiBold"
                                           Text="Fix" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource DialogBodyTextStyle}"
                                           Text="Review or explicitly start transcript, labeling, priority, or split work." />
                                <TextBlock Margin="0,10,0,0"
                                           FontWeight="SemiBold"
                                           Text="Transcript Processing" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="RetryTranscriptButton"
                                            Margin="0,0,10,10"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Click="RetryTranscriptButton_OnClick"
                                            Content="Retry Transcript" />
                                    <Button x:Name="ReTranscribeButton"
                                            Margin="0,0,10,10"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Click="ReTranscribeButton_OnClick"
                                            Content="Choose Model" />
                                    <Button x:Name="AddSpeakerLabelsButton"
                                            Margin="0,0,10,10"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Click="AddSpeakerLabelsButton_OnClick"
                                            Content="Add Speaker Labels" />
                                    <Button x:Name="ProcessAsapButton"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Click="ProcessAsapButton_OnClick"
                                            Content="Process ASAP" />
                                </WrapPanel>

                                <TextBlock Margin="0,10,0,0"
                                           FontWeight="SemiBold"
                                           Text="Split" />
                                <TextBox x:Name="SplitPointTextBox"
                                         Margin="0,6,0,0"
                                         Height="32"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Use mm:ss or hh:mm:ss." />
                                <Button x:Name="SplitButton"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Click="SplitButton_OnClick"
                                        Content="Split Into Two" />

                                <TextBlock Margin="0,16,0,0"
                                           FontWeight="SemiBold"
                                           Text="Speaker Name Review" />
                                <DataGrid x:Name="SpeakerLabelsDataGrid"
                                          Margin="0,8,0,0"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          RowHeaderWidth="0"
                                          Height="130">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Diarization Label"
                                                            Binding="{Binding OriginalLabel, Mode=OneWay}"
                                                            IsReadOnly="True"
                                                            Width="*" />
                                        <DataGridTextColumn Header="Meeting Display Name"
                                                            Binding="{Binding EditedLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="1.2*" />
                                        <DataGridTextColumn Header="Name Provenance"
                                                            Binding="{Binding Provenance, Mode=OneWay}"
                                                            IsReadOnly="True"
                                                            Width="1.2*" />
                                        <DataGridTextColumn Header="Local Name Suggestion"
                                                            Binding="{Binding SuggestionText, Mode=OneWay}"
                                                            IsReadOnly="True"
                                                            Width="1.1*" />
                                        <DataGridTemplateColumn Header="Review"
                                                                Width="205">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button MinWidth="94"
                                                                Height="26"
                                                                Margin="0,0,6,0"
                                                                Click="UseSpeakerSuggestionButton_OnClick"
                                                                IsEnabled="{Binding HasSuggestion}"
                                                                Content="Use suggestion" />
                                                        <Button MinWidth="102"
                                                                Height="26"
                                                                Click="RejectSpeakerSuggestionButton_OnClick"
                                                                IsEnabled="{Binding HasSuggestion}"
                                                                Content="Reject suggestion" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="ApplySpeakerNamesButton"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Click="ApplySpeakerNamesButton_OnClick"
                                            Content="Apply Name Changes" />
                                    <Button x:Name="RefreshSpeakerNamesButton"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Click="RefreshSpeakerNamesButton_OnClick"
                                            Content="Refresh Local Suggestions" />
                                    <Button x:Name="UndoSpeakerNameRecognitionButton"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Click="UndoSpeakerNameRecognitionButton_OnClick"
                                            Content="Undo Profile Names" />
                                </WrapPanel>
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource DialogBodyTextStyle}"
                                           Text="Refresh Suggestions checks local voice profiles from stored speaker samples only. Use Repair Speaker Labels above for suspicious speaker-label splits." />

                                <TextBlock x:Name="MaintenanceStatusTextBlock"
                                           Margin="0,12,0,0"
                                           Style="{StaticResource DialogBodyTextStyle}" />

                                <TextBlock Margin="0,16,0,0"
                                           FontWeight="SemiBold"
                                           Text="Archive" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource DialogBodyTextStyle}"
                                           Text="Archive is recoverable and stays separate from permanent deletion." />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="ArchiveButton"
                                            Margin="0,0,0,10"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Click="ArchiveButton_OnClick"
                                            Content="Archive" />
                                </WrapPanel>
                                <Border Margin="0,12,0,0"
                                        Padding="10"
                                        Background="#FFF2F2"
                                        BorderBrush="#B42318"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="Danger Zone" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource DialogBodyTextStyle}"
                                                   Text="Permanent delete requires typing DELETE and cannot be recommended automatically." />
                                    <Button x:Name="DeleteButton"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Click="DeleteButton_OnClick"
                                            Content="Delete Permanently" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2"
                    Style="{StaticResource DialogCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TranscriptSearchTextBox"
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 TextChanged="TranscriptSearchTextBox_OnTextChanged" />
                        <TextBlock x:Name="TranscriptStatusTextBlock"
                                   Grid.Column="1"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DialogBodyTextStyle}" />
                    </Grid>

                    <ListBox x:Name="TranscriptSegmentsListBox"
                             Grid.Row="1"
                             Margin="0,14,0,0"
                             BorderBrush="{StaticResource AppOutlineBrush}"
                             BorderThickness="1"
                             Background="{StaticResource AppMutedCardBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="{StaticResource AppMonoFontFamily}"
                                               Foreground="{StaticResource AppSecondaryBrush}"
                                               Text="{Binding Timestamp}" />
                                    <TextBlock Grid.Column="1"
                                               FontWeight="SemiBold"
                                               Text="{Binding SpeakerLabel}" />
                                    <TextBlock Grid.Column="2"
                                               TextWrapping="Wrap"
                                               Text="{Binding Text}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterStatusTextBlock"
                       AutomationProperties.LiveSetting="Polite"
                       VerticalAlignment="Center"
                       Style="{StaticResource DialogBodyTextStyle}" />
            <Button Grid.Column="1"
                    AutomationProperties.Name="Close meeting details"
                    Style="{StaticResource SecondaryActionButtonStyle}"
                    Click="CloseButton_OnClick"
                    Content="Close" />
        </Grid>
    </Grid>
</Window>
